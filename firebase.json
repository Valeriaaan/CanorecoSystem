{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/pages/news",
        "destination": "/pages/news/news.html"
      },
      {
        "source": "/pages/dashboard",
        "destination": "/pages/dashboard/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
